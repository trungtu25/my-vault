{
	"appId": "com.yourname.vault",
	"appName": "Personal Vault",
	"webDir": "www",
	"bundledWebRuntime": false,
	"plugins": {
		"BiometricAuth": {
			"androidBiometricStrength": "BIOMETRIC_STRONG"
		}
	},
	"ios": {
		"contentInset": "always",
		"allowsLinkPreview": false,
		"scrollEnabled": false
	},
	"android": {
		"allowMixedContent": false,
		"captureInput": true,
		"webContentsDebuggingEnabled": false
	}
}
